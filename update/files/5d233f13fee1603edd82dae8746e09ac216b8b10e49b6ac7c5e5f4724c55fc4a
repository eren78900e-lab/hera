<!doctype html>
<html><head><meta charset="utf-8"><title>Kozmetik onizleme</title>
<script type="importmap">{"imports":{"three":"./vendor/three.module.min.js"}}</script>
<style>body{margin:0;background:#15141a;color:#ddd;font:13px Segoe UI}#g{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:8px}.c{background:#1e1d24;border-radius:10px;padding:6px}.c canvas{width:100%;aspect-ratio:1;display:block}</style>
</head><body><div id="g"></div>
<script type="module">
import { CosView } from './cosview.js';
const q = new URLSearchParams(location.search);
const cat = await (await fetch('cosmetics/catalog.json')).json();
const g = document.getElementById('g');
if (q.get('cols')) g.style.gridTemplateColumns = `repeat(${q.get('cols')},1fr)`;
const only = q.get('only');
const list = only ? ['front', 'side', 'back', 'top'].map(v => ({ ...cat.items.find(i => i.id === only), v })) : cat.items;
for (const it of list) {
  const d = document.createElement('div'); d.className = 'c';
  d.innerHTML = `<canvas></canvas><div>${it.name} ${it.v || ''}</div>`; g.appendChild(d);
  const v = new CosView(d.querySelector('canvas'), { static: false });
  v.ctl.target.set(0, only ? 29 : 22, 0);
  if (only) {
    const f = +(q.get('far') || 1), ty = only ? 29 + (f - 1) * 6 : 22;
    v.ctl.target.set(0, ty, 0);
    const p = { front: [-10, 33, -22], side: [-24, 33, 2], back: [10, 34, 22], top: [-12, 46, -14] }[it.v];
    v.cam.position.set(p[0] * f, ty + (p[1] - 29) * f, p[2] * f); v.ctl.minDistance = 5; v.ctl.update();
  }
  else if (it.slot === 'sirt' || it.slot === 'pelerin') v.view('back'); else v.view('front');
  await v.set(it.slot, it.id, it.anim);
}
window.READY = true;
</script></body></html>

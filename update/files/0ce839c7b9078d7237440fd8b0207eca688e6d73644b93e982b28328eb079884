<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<title>Hera Launcher</title>
<link rel="stylesheet" href="app.css">
</head>
<body>
<div id="boot"><img src="logo.png" alt=""></div>
<div class="aura"></div>
<canvas id="bgfx"></canvas>
<div class="grain"></div>

<aside id="side">
  <div class="logo" data-go="home"><img src="logo.png" alt="Hera"></div>
  <nav>
    <button data-go="home" class="on"><svg class="i"><use href="#i-home"/></svg><span class="tip">Ana Sayfa</span></button>
    <button data-go="profiles"><svg class="i"><use href="#i-layers"/></svg><span class="tip">Profiller</span></button>
    <button data-go="shop"><svg class="i"><use href="#i-box"/></svg><span class="tip">Mod Mağazası</span></button>
    <button data-go="pvp"><svg class="i"><use href="#i-sword"/></svg><span class="tip">PvP Ayarları</span></button>
    <button data-go="settings"><svg class="i"><use href="#i-gear"/></svg><span class="tip">Ayarlar</span></button>
  </nav>
  <button class="acct" id="acctBtn"></button>
</aside>

<div id="titlebar">
  <div class="drag" id="drag"><b>Hera</b> Launcher <span id="verTxt"></span></div>
  <button class="chip live" id="updBtn" style="display:none"><svg class="i"><use href="#i-update"/></svg><span></span></button>
  <button class="chip" id="conBtn"><svg class="i"><use href="#i-term"/></svg>Konsol</button>
  <button class="tb" data-win="min"><svg class="i"><use href="#i-min"/></svg></button>
  <button class="tb" data-win="max"><svg class="i"><use href="#i-max"/></svg></button>
  <button class="tb close" data-win="close"><svg class="i"><use href="#i-x"/></svg></button>
</div>

<main>
  <!-- ======================= ANA SAYFA -->
  <section class="page on" id="home">
    <div class="hero">
      <img class="heroart" src="logo_bw.png" alt="">
      <div class="hero-l">
        <div class="kicker">CraftHera Resmi Launcher</div>
        <div class="wordmark"><span class="w">HERA</span><span class="shine">HERA</span></div>
        <p class="tagline">PvP için ayarlanmış <b>hızlı ve hafif</b> Minecraft. Tek tık ile <b>oyna.crafthera.com</b>'a bağlan; FPS paketi, PvP HUD ve Hera rozeti hazır gelir.</p>
        <div class="feats">
          <div class="feat"><div class="ic"><svg class="i"><use href="#i-bolt"/></svg></div>FPS Paketi</div>
          <div class="feat"><div class="ic"><svg class="i"><use href="#i-sword"/></svg></div>PvP HUD</div>
          <div class="feat"><div class="ic"><svg class="i"><use href="#i-crown"/></svg></div>Hera Rozeti</div>
          <div class="feat"><div class="ic"><svg class="i"><use href="#i-layers"/></svg></div>1.8.9 → 26.x</div>
        </div>
      </div>
      <div class="hero-r">
        <div class="card srv" id="srvCard">
          <div class="srv-top">
            <img class="srv-ico" id="srvIco" src="logo.png" alt="">
            <div style="flex:1;min-width:0">
              <div class="srv-name">CraftHera</div>
              <div class="srv-host">oyna.crafthera.com <button id="copyIp" title="Kopyala"><svg class="i" style="width:14px"><use href="#i-copy"/></svg></button></div>
            </div>
            <button class="iconbtn" id="srvRefresh" title="Yenile"><svg class="i"><use href="#i-refresh"/></svg></button>
          </div>
          <div class="srv-stats">
            <div class="stat"><div class="k">Çevrimiçi</div><div class="v"><span class="pulse" id="srvDot"></span><span id="srvOnline">—</span></div></div>
            <div class="stat"><div class="k">Gecikme</div><div class="v" id="srvPing">—</div></div>
          </div>
          <div class="motd" id="srvMotd"><span class="skel" style="display:block;height:14px;width:80%"></span></div>
        </div>
        <div class="card tips">
          <h3><svg class="i"><use href="#i-spark"/></svg>Hera ipuçları</h3>
          <div class="tip-i"><span class="n">01</span><span><b>Sağ Shift</b> ile oyun içinde Hera menüsünü aç, HUD'u sürükleyip yerleştir.</span></div>
          <div class="tip-i"><span class="n">02</span><span><b>C</b> tuşu yakınlaştırır; tekerlek ile zoom ayarlanır.</span></div>
          <div class="tip-i"><span class="n">03</span><span>Hera kullananların isminin solunda <b>taç rozeti</b> görünür.</span></div>
        </div>
      </div>
    </div>
    <div class="dock">
      <div class="psel" id="psel"></div>
      <div class="mid">
        <div class="prog-l"><b id="progStage">Hazır</b><span id="progPct"></span></div>
        <div class="bar" id="progBar"><i></i></div>
        <div class="meta" id="dockMeta"></div>
      </div>
      <button class="play" id="playBtn"><svg class="i"><use href="#i-play"/></svg><span>OYNA</span></button>
    </div>
  </section>

  <!-- ======================= PROFILLER -->
  <section class="page" id="profiles">
    <div class="ph">
      <div><h1>Profiller</h1><p>Her profil kendi sürümü, modları ve ayarlarıyla ayrı bir dünya. 1.8.9'dan en yeni sürüme kadar.</p></div>
      <button class="btn pri" id="newProf"><svg class="i"><use href="#i-plus"/></svg>Yeni profil</button>
    </div>
    <div class="pgrid" id="pgrid"></div>
  </section>

  <!-- ======================= MAGAZA -->
  <section class="page" id="shop">
    <div class="ph">
      <div><h1>Mod Mağazası</h1><p>Modrinth'teki binlerce mod, kaynak paketi ve shader — seçili profile uyumlu olanlar.</p></div>
      <div class="seg" id="shopTabs">
        <button data-t="mod" class="on"><svg class="i"><use href="#i-box"/></svg>Modlar</button>
        <button data-t="resourcepack"><svg class="i"><use href="#i-image"/></svg>Kaynak Paketleri</button>
        <button data-t="shader"><svg class="i"><use href="#i-sun"/></svg>Shader</button>
        <button data-t="installed"><svg class="i"><use href="#i-check"/></svg>Yüklü</button>
      </div>
    </div>
    <div class="shop-top">
      <div class="selp" id="shopProf"></div>
      <div class="search"><svg class="i"><use href="#i-search"/></svg><input class="input" id="shopQ" placeholder="Ara: sodium, iris, freelook…"></div>
      <select class="input" id="shopSort">
        <option value="relevance">En alakalı</option>
        <option value="downloads">En çok indirilen</option>
        <option value="follows">En popüler</option>
        <option value="updated">Son güncellenen</option>
        <option value="newest">En yeni</option>
      </select>
    </div>
    <div class="cats" id="shopCats"></div>
    <div id="shopBody"></div>
  </section>

  <!-- ======================= PVP -->
  <section class="page" id="pvp">
    <div class="ph">
      <div><h1>PvP Ayarları</h1><p>Hera modunun oyun içi özellikleri. Değişiklikler oyunu bir sonraki açışında (ya da Sağ Shift menüsünde anında) uygulanır.</p></div>
      <div class="selp" id="pvpProf"></div>
    </div>
    <div class="pvp">
      <div id="pvpSets" class="locked"></div>
      <div class="card preview">
        <h3><span>Canlı önizleme</span><span class="badge gold"><svg class="i"><use href="#i-crown"/></svg>Hera</span></h3>
        <div class="scene" id="scene"></div>
      </div>
    </div>
  </section>

  <!-- ======================= AYARLAR -->
  <section class="page" id="settings">
    <div class="ph"><div><h1>Ayarlar</h1><p>Bellek, ekran, Java ve launcher davranışı.</p></div></div>
    <div class="sgrid" id="sgrid"></div>
  </section>
</main>

<section id="console">
  <div class="ch"><b>Oyun konsolu</b>
    <button class="btn sm" id="conCopy"><svg class="i"><use href="#i-copy"/></svg>Kopyala</button>
    <button class="btn sm danger" id="conKill"><svg class="i"><use href="#i-stop"/></svg>Oyunu kapat</button>
    <button class="iconbtn" id="conClose"><svg class="i"><use href="#i-down"/></svg></button>
  </div>
  <pre id="conPre"></pre>
</section>
<div id="toasts"></div>


:root {
  --bg: #08080b;
  --bg2: #0e0e13;
  --panel: rgba(255, 255, 255, .035);
  --panel2: rgba(255, 255, 255, .06);
  --line: rgba(255, 255, 255, .075);
  --line2: rgba(255, 255, 255, .13);
  --text: #f4f1ea;
  --mute: #9a968d;
  --dim: #65625b;
  --a1: #ffcf4a;
  --a2: #ff9a1f;
  --a3: #ff6a00;
  --agrad: linear-gradient(135deg, #ffe07a 0%, #ffb52e 42%, #ff7a12 100%);
  --aglow: rgba(255, 170, 40, .35);
  --ok: #3ee08f;
  --bad: #ff5a5a;
  --r: 16px;
  --r2: 11px;
  --side: 76px;
  --title: 40px;
}
:root[data-accent="crimson"] { --a1: #ff8a8a; --a2: #ff4d5e; --a3: #d61f3c; --agrad: linear-gradient(135deg, #ffb0a8 0%, #ff5468 45%, #c4142f 100%); --aglow: rgba(255, 70, 90, .33); }
:root[data-accent="ice"] { --a1: #b5f0ff; --a2: #4fc7ff; --a3: #2378ff; --agrad: linear-gradient(135deg, #d6f8ff 0%, #5cc8ff 45%, #2d6bff 100%); --aglow: rgba(70, 170, 255, .33); }
:root[data-accent="emerald"] { --a1: #b4ffd2; --a2: #34e08a; --a3: #0fa85e; --agrad: linear-gradient(135deg, #d4ffe3 0%, #3fe38f 45%, #0b9653 100%); --aglow: rgba(50, 220, 130, .3); }
:root[data-accent="violet"] { --a1: #e3cbff; --a2: #a96bff; --a3: #7232f0; --agrad: linear-gradient(135deg, #efe0ff 0%, #ae74ff 45%, #6a2be6 100%); --aglow: rgba(160, 100, 255, .33); }

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  background: var(--bg);
  color: var(--text);
  font: 14px/1.45 Inter, "Segoe UI Variable Text", "Segoe UI", sans-serif;
  overflow: hidden;
  user-select: none;
  -webkit-font-smoothing: antialiased;
}
body.noanim *, body.noanim *::before, body.noanim *::after { animation: none !important; transition: none !important; }
h1, h2, h3, .disp { font-family: Outfit, Inter, sans-serif; letter-spacing: -.01em; }
button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
input, select, textarea { font: inherit; color: inherit; user-select: text; }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, .09); border-radius: 10px; border: 3px solid transparent; background-clip: padding-box; }
::-webkit-scrollbar-thumb:hover { background-color: rgba(255, 255, 255, .16); }
::selection { background: var(--aglow); }
svg.i { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; flex: none; }

/* ------------------------------------------------------------------ zemin */
#bgfx { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
.aura { position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background:
    radial-gradient(900px 520px at 78% -10%, var(--aglow), transparent 65%),
    radial-gradient(700px 500px at -5% 110%, rgba(255, 120, 20, .10), transparent 60%),
    radial-gradient(1200px 800px at 50% 50%, rgba(255,255,255,.015), transparent 70%);
  opacity: .9; }
.grain { position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: .05;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='.9'/></svg>"); }

/* ------------------------------------------------------------------ baslik cubugu */
#titlebar { position: fixed; top: 0; left: var(--side); right: 0; height: var(--title); z-index: 50; display: flex; align-items: center; }
#titlebar .drag { flex: 1; height: 100%; display: flex; align-items: center; gap: 10px; padding-left: 26px; color: var(--dim); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; }
#titlebar .drag b { color: var(--mute); font-weight: 600; }
#titlebar .tb { width: 46px; height: 100%; display: grid; place-items: center; color: var(--mute); transition: background .15s, color .15s; }
#titlebar .tb:hover { background: rgba(255, 255, 255, .06); color: var(--text); }
#titlebar .tb.close:hover { background: #e5303a; color: #fff; }
#titlebar .tb svg { width: 15px; height: 15px; }
#titlebar .chip { height: 26px; padding: 0 11px; border-radius: 99px; display: flex; align-items: center; gap: 7px; margin-right: 8px; color: var(--mute); background: var(--panel); border: 1px solid var(--line); font-size: 12px; transition: .15s; }
#titlebar .chip:hover { color: var(--text); border-color: var(--line2); }
#titlebar .chip svg { width: 14px; height: 14px; }
#titlebar .chip.live { color: var(--a1); border-color: color-mix(in srgb, var(--a2) 40%, transparent); }

/* ------------------------------------------------------------------ yan menu */
#side { position: fixed; left: 0; top: 0; bottom: 0; width: var(--side); z-index: 60; display: flex; flex-direction: column; align-items: center; padding: 16px 0 14px;
  background: linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.01)); border-right: 1px solid var(--line); }
#side .logo { width: 46px; height: 46px; display: grid; place-items: center; margin-bottom: 22px; position: relative; cursor: pointer; }
#side .logo img { width: 46px; height: 46px; filter: drop-shadow(0 6px 18px var(--aglow)); transition: transform .3s cubic-bezier(.2, 1.6, .4, 1); }
#side .logo:hover img { transform: rotate(-6deg) scale(1.08); }
#side nav { display: flex; flex-direction: column; gap: 6px; flex: 1; }
#side nav button, #side .acct { width: 50px; height: 50px; border-radius: 15px; display: grid; place-items: center; color: var(--dim); position: relative; transition: color .2s, background .2s; }
#side nav button svg { width: 22px; height: 22px; }
#side nav button:hover { color: var(--text); background: var(--panel); }
#side nav button.on { color: #1a1205; background: var(--agrad); box-shadow: 0 8px 26px -6px var(--aglow), inset 0 1px 0 rgba(255,255,255,.5); }
#side nav button .tip, #side .acct .tip { position: absolute; left: 62px; top: 50%; transform: translate(-6px, -50%); white-space: nowrap; padding: 6px 11px; border-radius: 9px; background: #1b1b22; border: 1px solid var(--line2); color: var(--text); font-size: 12.5px; font-weight: 500; opacity: 0; pointer-events: none; transition: .15s; box-shadow: 0 10px 30px rgba(0,0,0,.5); }
#side nav button:hover .tip, #side .acct:hover .tip { opacity: 1; transform: translate(0, -50%); }
#side .acct { width: 46px; height: 46px; border-radius: 13px; overflow: visible; }
#side .acct img { width: 40px; height: 40px; border-radius: 11px; image-rendering: pixelated; box-shadow: 0 0 0 2px var(--bg), 0 0 0 3.5px color-mix(in srgb, var(--a2) 70%, transparent); }
#side .acct .noacc { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; background: var(--panel2); border: 1px dashed var(--line2); color: var(--mute); }
#side .acct .dot { position: absolute; right: -1px; bottom: -1px; width: 12px; height: 12px; border-radius: 50%; background: var(--ok); border: 2.5px solid var(--bg); }

/* ------------------------------------------------------------------ sayfalar */
main { position: fixed; left: var(--side); top: 0; right: 0; bottom: 0; z-index: 1; }
.page { position: absolute; inset: 0; padding: calc(var(--title) + 14px) 34px 30px; overflow-y: auto; opacity: 0; pointer-events: none; transform: translateY(8px); transition: opacity .28s, transform .35s cubic-bezier(.2, .9, .3, 1); }
.page.on { opacity: 1; pointer-events: auto; transform: none; }
.ph { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
.ph h1 { font-size: 30px; font-weight: 700; }
.ph p { color: var(--mute); margin-top: 3px; }
.grad { background: var(--agrad); -webkit-background-clip: text; background-clip: text; color: transparent; }

/* ------------------------------------------------------------------ ortak bilesenler */
.card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--r); backdrop-filter: blur(14px); }
.btn { height: 38px; padding: 0 16px; border-radius: 11px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 600; font-size: 13.5px; background: var(--panel2); border: 1px solid var(--line); transition: .15s; white-space: nowrap; }
.btn:hover { background: rgba(255,255,255,.09); border-color: var(--line2); }
.btn:active { transform: translateY(1px); }
.btn.pri { background: var(--agrad); color: #1c1203; border: 0; box-shadow: 0 8px 24px -8px var(--aglow), inset 0 1px 0 rgba(255,255,255,.45); }
.btn.pri:hover { filter: brightness(1.07); }
.btn.ghost { background: none; border-color: transparent; color: var(--mute); }
.btn.ghost:hover { color: var(--text); background: var(--panel); }
.btn.danger:hover { background: rgba(255, 70, 70, .14); border-color: rgba(255, 90, 90, .4); color: #ffb3b3; }
.btn.sm { height: 31px; padding: 0 12px; font-size: 12.5px; border-radius: 9px; }
.btn[disabled] { opacity: .45; pointer-events: none; }
.btn svg { width: 16px; height: 16px; }
.iconbtn { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; color: var(--mute); transition: .15s; }
.iconbtn:hover { background: var(--panel2); color: var(--text); }
.iconbtn svg { width: 17px; height: 17px; }

.input { height: 40px; width: 100%; padding: 0 14px; border-radius: 11px; background: rgba(0,0,0,.28); border: 1px solid var(--line); outline: 0; transition: .15s; }
.input:focus { border-color: color-mix(in srgb, var(--a2) 60%, transparent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--a2) 14%, transparent); }
.input::placeholder { color: var(--dim); }
.search { position: relative; }
.search svg { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--dim); width: 17px; }
.search .input { padding-left: 40px; }
label.f { display: block; font-size: 12px; font-weight: 600; color: var(--mute); text-transform: uppercase; letter-spacing: .07em; margin: 0 0 7px 2px; }

.seg { display: inline-flex; padding: 4px; gap: 3px; border-radius: 12px; background: rgba(0,0,0,.3); border: 1px solid var(--line); }
.seg button { height: 30px; padding: 0 13px; border-radius: 9px; color: var(--mute); font-weight: 600; font-size: 12.5px; transition: .15s; display: inline-flex; align-items: center; gap: 6px; }
.seg button:hover { color: var(--text); }
.seg button.on { background: var(--panel2); color: var(--text); box-shadow: inset 0 0 0 1px var(--line2), 0 4px 12px rgba(0,0,0,.3); }
.seg button[disabled] { opacity: .3; pointer-events: none; }
.seg button svg { width: 14px; height: 14px; }

.tog { width: 40px; height: 23px; border-radius: 99px; background: rgba(255,255,255,.11); position: relative; transition: .2s; flex: none; cursor: pointer; }
.tog::after { content: ""; position: absolute; left: 3px; top: 3px; width: 17px; height: 17px; border-radius: 50%; background: #d8d4cb; transition: .25s cubic-bezier(.3, 1.5, .5, 1); box-shadow: 0 2px 5px rgba(0,0,0,.4); }
.tog.on { background: var(--agrad); }
.tog.on::after { left: 20px; background: #fff; }

.badge { display: inline-flex; align-items: center; gap: 5px; height: 22px; padding: 0 9px; border-radius: 7px; font-size: 11.5px; font-weight: 600; background: var(--panel2); border: 1px solid var(--line); color: var(--mute); white-space: nowrap; }
.badge.gold { color: var(--a1); border-color: color-mix(in srgb, var(--a2) 35%, transparent); background: color-mix(in srgb, var(--a2) 10%, transparent); }
.badge.green { color: #8ff0bd; border-color: rgba(62, 224, 143, .3); background: rgba(62, 224, 143, .08); }
.badge svg { width: 12px; height: 12px; }

.range { -webkit-appearance: none; appearance: none; width: 100%; height: 6px; border-radius: 9px; background: linear-gradient(90deg, var(--a2) 0 var(--p, 50%), rgba(255,255,255,.1) var(--p, 50%) 100%); outline: 0; }
.range::-webkit-slider-thumb { -webkit-appearance: none; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 5px color-mix(in srgb, var(--a2) 30%, transparent), 0 3px 10px rgba(0,0,0,.5); cursor: grab; }

.empty { text-align: center; color: var(--mute); padding: 60px 20px; }
.empty svg { width: 42px; height: 42px; color: var(--dim); margin-bottom: 12px; }
.spin { width: 18px; height: 18px; border-radius: 50%; border: 2.5px solid rgba(255,255,255,.15); border-top-color: var(--a1); animation: spin .8s linear infinite; display: inline-block; }
@keyframes spin { to { transform: rotate(360deg); } }
.skel { background: linear-gradient(90deg, rgba(255,255,255,.04), rgba(255,255,255,.08), rgba(255,255,255,.04)); background-size: 200% 100%; animation: sk 1.3s ease infinite; border-radius: 8px; }
@keyframes sk { to { background-position: -200% 0; } }

/* ------------------------------------------------------------------ ANA SAYFA */
#home { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
.hero { flex: 1; position: relative; display: grid; grid-template-columns: 1fr 360px; gap: 30px; padding: calc(var(--title) + 30px) 40px 0; min-height: 0; }
.hero-l { display: flex; flex-direction: column; justify-content: center; padding-bottom: 40px; position: relative; }
.kicker { display: inline-flex; align-items: center; gap: 9px; color: var(--a1); font-weight: 600; font-size: 12.5px; letter-spacing: .2em; text-transform: uppercase; margin-bottom: 18px; }
.kicker::before { content: ""; width: 28px; height: 2px; background: var(--agrad); border-radius: 2px; }
.wordmark { font-family: Outfit; font-weight: 800; font-size: clamp(76px, 10vw, 138px); line-height: .86; letter-spacing: -.045em; position: relative; }
.wordmark .w { background: linear-gradient(180deg, #fff 10%, #e8dcc2 60%, #a8957a 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
.wordmark .shine { position: absolute; inset: 0; background: linear-gradient(105deg, transparent 35%, rgba(255,235,180,.9) 48%, transparent 60%); background-size: 250% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shine 6s ease-in-out infinite; }
@keyframes shine { 0%, 60% { background-position: 150% 0; } 100% { background-position: -100% 0; } }
.tagline { font-size: 17px; color: var(--mute); max-width: 520px; margin-top: 20px; line-height: 1.6; }
.tagline b { color: var(--text); font-weight: 600; }
.feats { display: flex; gap: 10px; margin-top: 26px; flex-wrap: wrap; }
.feat { display: flex; align-items: center; gap: 9px; padding: 9px 14px 9px 10px; border-radius: 12px; background: var(--panel); border: 1px solid var(--line); font-size: 13px; font-weight: 500; color: #d9d4c9; }
.feat .ic { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; background: color-mix(in srgb, var(--a2) 14%, transparent); color: var(--a1); }
.feat .ic svg { width: 16px; height: 16px; }
.heroart { position: absolute; right: 360px; top: 50%; transform: translateY(-50%); width: 430px; height: 430px; opacity: .1; pointer-events: none; filter: grayscale(1) contrast(1.2); }

.hero-r { display: flex; flex-direction: column; gap: 14px; padding-bottom: 24px; justify-content: center; }
.srv { padding: 18px; position: relative; overflow: hidden; }
.srv::before { content: ""; position: absolute; inset: 0; background: radial-gradient(400px 160px at 100% 0, var(--aglow), transparent 70%); opacity: .5; pointer-events: none; }
.srv-top { display: flex; align-items: center; gap: 13px; position: relative; }
.srv-ico { width: 52px; height: 52px; border-radius: 13px; image-rendering: pixelated; background: #000; box-shadow: 0 6px 20px rgba(0,0,0,.5); }
.srv-name { font-family: Outfit; font-weight: 700; font-size: 19px; }
.srv-host { color: var(--mute); font-size: 12.5px; display: flex; align-items: center; gap: 6px; }
.srv-host button { color: var(--dim); }
.srv-host button:hover { color: var(--a1); }
.srv-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; position: relative; }
.stat { padding: 11px 13px; border-radius: 12px; background: rgba(0,0,0,.25); border: 1px solid var(--line); }
.stat .k { font-size: 11px; color: var(--dim); text-transform: uppercase; letter-spacing: .1em; font-weight: 600; }
.stat .v { font-family: Outfit; font-size: 22px; font-weight: 700; margin-top: 2px; display: flex; align-items: center; gap: 8px; }
.pulse { width: 9px; height: 9px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 0 rgba(62,224,143,.6); animation: pulse 1.8s infinite; }
.pulse.off { background: var(--bad); animation: none; }
@keyframes pulse { 70% { box-shadow: 0 0 0 9px rgba(62,224,143,0); } 100% { box-shadow: 0 0 0 0 rgba(62,224,143,0); } }
.motd { margin-top: 12px; font-family: Consolas, monospace; font-size: 12.5px; line-height: 1.5; padding: 10px 12px; border-radius: 11px; background: rgba(0,0,0,.35); border: 1px solid var(--line); min-height: 44px; position: relative; white-space: pre-wrap; }
.tips { padding: 16px 18px; }
.tips h3 { font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; margin-bottom: 10px; color: var(--mute); }
.tips h3 svg { color: var(--a1); width: 16px; }
.tip-i { display: flex; gap: 11px; padding: 9px 0; border-top: 1px solid var(--line); font-size: 13px; color: #cfcabe; }
.tip-i:first-of-type { border-top: 0; }
.tip-i .n { font-family: Outfit; font-weight: 700; color: var(--a2); width: 18px; flex: none; }

/* oyna cubugu */
.dock { margin: 0 40px 28px; padding: 14px; display: flex; align-items: center; gap: 14px; position: relative; z-index: 2;
  background: linear-gradient(180deg, rgba(22,20,26,.86), rgba(14,13,17,.92)); border: 1px solid var(--line2); border-radius: 22px; box-shadow: 0 30px 60px -20px rgba(0,0,0,.8), inset 0 1px 0 rgba(255,255,255,.06); backdrop-filter: blur(20px); }
.psel { display: flex; align-items: center; gap: 13px; padding: 8px 14px 8px 8px; border-radius: 15px; cursor: pointer; transition: .15s; min-width: 260px; position: relative; }
.psel:hover { background: var(--panel); }
.picon { width: 48px; height: 48px; border-radius: 13px; display: grid; place-items: center; flex: none; background: linear-gradient(145deg, rgba(255,255,255,.09), rgba(255,255,255,.02)); border: 1px solid var(--line2); color: var(--a1); overflow: hidden; }
.picon img { width: 38px; height: 38px; }
.picon svg { width: 24px; height: 24px; }
.psel .nm { font-weight: 700; font-family: Outfit; font-size: 17px; }
.psel .sub { color: var(--mute); font-size: 12.5px; display: flex; gap: 6px; align-items: center; }
.psel .chev { margin-left: auto; color: var(--dim); }
.dock .mid { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 8px; padding: 0 6px; }
.prog-l { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--mute); gap: 10px; }
.prog-l b { color: var(--text); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar { height: 7px; border-radius: 9px; background: rgba(255,255,255,.07); overflow: hidden; position: relative; }
.bar i { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--agrad); border-radius: 9px; transition: width .25s; box-shadow: 0 0 14px var(--aglow); }
.bar.ind i { width: 30% !important; animation: ind 1.2s ease-in-out infinite; }
@keyframes ind { 0% { left: -30%; } 100% { left: 100%; } }
.dock .meta { display: flex; gap: 18px; color: var(--mute); font-size: 12.5px; }
.dock .meta span { display: flex; align-items: center; gap: 6px; }
.dock .meta svg { width: 14px; height: 14px; color: var(--dim); }
.play { height: 64px; min-width: 230px; padding: 0 30px; border-radius: 17px; font-family: Outfit; font-size: 22px; font-weight: 800; letter-spacing: .06em; color: #1d1203;
  background: var(--agrad); position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; gap: 12px;
  box-shadow: 0 16px 40px -10px var(--aglow), 0 0 0 1px rgba(255,255,255,.25) inset, 0 -3px 0 rgba(0,0,0,.18) inset; transition: transform .15s, filter .2s, box-shadow .2s; }
.play::after { content: ""; position: absolute; top: 0; bottom: 0; width: 60px; left: -90px; background: linear-gradient(100deg, transparent, rgba(255,255,255,.55), transparent); transform: skewX(-20deg); animation: sweep 3.8s ease-in-out infinite; }
@keyframes sweep { 0%, 70% { left: -90px; } 100% { left: 120%; } }
.play:hover { filter: brightness(1.08); transform: translateY(-1px); box-shadow: 0 22px 50px -10px var(--aglow), 0 0 0 1px rgba(255,255,255,.3) inset, 0 -3px 0 rgba(0,0,0,.18) inset; }
.play:active { transform: translateY(1px) scale(.99); }
.play svg { width: 24px; height: 24px; fill: currentColor; stroke: none; }
.play.busy { background: linear-gradient(135deg, #2a2620, #1c1a16); color: var(--a1); box-shadow: inset 0 0 0 1px var(--line2); }
.play.busy::after { display: none; }
.play.running { background: linear-gradient(135deg, #1b2a21, #12201a); color: #8ff0bd; box-shadow: inset 0 0 0 1px rgba(62,224,143,.35); }
.play.running::after { display: none; }
.play small { font-size: 12px; letter-spacing: .02em; font-weight: 600; display: block; opacity: .75; }

/* profil acilir listesi */
.pop { position: fixed; z-index: 300; min-width: 300px; max-height: 420px; overflow-y: auto; padding: 7px; border-radius: 16px; background: #15141a; border: 1px solid var(--line2); box-shadow: 0 30px 70px rgba(0,0,0,.7); animation: popin .18s cubic-bezier(.2, .9, .3, 1.2); }
@keyframes popin { from { opacity: 0; transform: translateY(8px) scale(.97); } }
.pop .it { display: flex; align-items: center; gap: 11px; padding: 8px 10px; border-radius: 11px; cursor: pointer; }
.pop .it:hover { background: var(--panel2); }
.pop .it.on { background: color-mix(in srgb, var(--a2) 12%, transparent); }
.pop .it .picon { width: 36px; height: 36px; border-radius: 10px; }
.pop .it .picon img { width: 28px; height: 28px; }
.pop .it .picon svg { width: 18px; height: 18px; }
.pop .it b { font-weight: 600; display: block; }
.pop .it small { color: var(--mute); font-size: 12px; }
.pop .sep { height: 1px; background: var(--line); margin: 5px 4px; }

/* ------------------------------------------------------------------ PROFILLER */
.pgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 16px; }
.pcard { padding: 18px; position: relative; overflow: hidden; transition: transform .2s, border-color .2s, box-shadow .2s; cursor: pointer; }
.pcard:hover { transform: translateY(-3px); border-color: var(--line2); box-shadow: 0 20px 40px -18px rgba(0,0,0,.8); }
.pcard.sel { border-color: color-mix(in srgb, var(--a2) 55%, transparent); box-shadow: 0 0 0 1px color-mix(in srgb, var(--a2) 30%, transparent), 0 20px 50px -24px var(--aglow); }
.pcard .glow { position: absolute; right: -60px; top: -60px; width: 180px; height: 180px; border-radius: 50%; background: radial-gradient(var(--aglow), transparent 70%); opacity: 0; transition: .3s; }
.pcard:hover .glow, .pcard.sel .glow { opacity: .7; }
.pcard .top { display: flex; gap: 13px; align-items: center; position: relative; }
.pcard .picon { width: 54px; height: 54px; border-radius: 15px; }
.pcard h3 { font-size: 17px; font-weight: 700; }
.pcard .bd { display: flex; gap: 6px; margin-top: 5px; flex-wrap: wrap; }
.pcard .info { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 16px; position: relative; }
.pcard .info div { font-size: 12px; color: var(--dim); }
.pcard .info b { display: block; color: #d9d4c9; font-weight: 600; font-size: 13px; }
.pcard .act { display: flex; gap: 6px; margin-top: 16px; position: relative; }
.pcard .act .btn { flex: 1; }
.pcard.new { display: grid; place-items: center; text-align: center; border-style: dashed; color: var(--mute); min-height: 220px; }
.pcard.new:hover { color: var(--a1); }
.pcard.new .plus { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; margin: 0 auto 12px; background: var(--panel2); }
.pcard.new .plus svg { width: 26px; height: 26px; }

/* modal */
.modal-bg { position: fixed; inset: 0; z-index: 200; background: rgba(4,4,6,.66); backdrop-filter: blur(6px); display: grid; place-items: center; animation: fade .2s; }
@keyframes fade { from { opacity: 0; } }
.modal { width: min(720px, calc(100vw - 60px)); max-height: calc(100vh - 80px); display: flex; flex-direction: column; background: #121116; border: 1px solid var(--line2); border-radius: 22px; box-shadow: 0 40px 100px rgba(0,0,0,.8); animation: popin .25s cubic-bezier(.2, .9, .3, 1.1); overflow: hidden; }
.modal.sm { width: min(460px, calc(100vw - 60px)); }
.modal .mh { padding: 22px 24px 4px; display: flex; align-items: center; gap: 12px; }
.modal .mh h2 { font-size: 21px; font-weight: 700; flex: 1; }
.modal .mb { padding: 16px 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 18px; }
.modal .mf { padding: 16px 24px 22px; display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid var(--line); background: rgba(0,0,0,.18); }
.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.icons { display: flex; gap: 8px; flex-wrap: wrap; }
.icons button { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--panel); border: 1px solid var(--line); color: var(--mute); transition: .15s; }
.icons button img { width: 30px; height: 30px; }
.icons button svg { width: 20px; height: 20px; }
.icons button:hover { color: var(--text); }
.icons button.on { border-color: var(--a2); color: var(--a1); box-shadow: 0 0 0 3px color-mix(in srgb, var(--a2) 20%, transparent); }
.vlist { position: relative; height: 236px; overflow-y: auto; border-radius: 13px; border: 1px solid var(--line); background: rgba(0,0,0,.25); padding: 5px; }
.vrow { display: flex; align-items: center; gap: 10px; padding: 8px 11px; border-radius: 9px; cursor: pointer; font-size: 13.5px; }
.vrow:hover { background: var(--panel2); }
.vrow.on { background: color-mix(in srgb, var(--a2) 16%, transparent); color: var(--a1); font-weight: 600; }
.vrow .ty { margin-left: auto; font-size: 11.5px; color: var(--dim); }
.vrow .star { color: var(--a1); width: 14px; height: 14px; }
.vtools { display: flex; gap: 10px; align-items: center; margin-bottom: 9px; }
.vtools .search { flex: 1; }
.chk { display: inline-flex; align-items: center; gap: 8px; color: var(--mute); font-size: 12.5px; cursor: pointer; white-space: nowrap; }
.opt { display: flex; align-items: center; gap: 14px; padding: 13px 15px; border-radius: 13px; background: var(--panel); border: 1px solid var(--line); }
.opt .ic { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: color-mix(in srgb, var(--a2) 13%, transparent); color: var(--a1); flex: none; }
.opt .ic svg { width: 18px; height: 18px; }
.opt .tx { flex: 1; min-width: 0; }
.opt .tx b { display: block; font-weight: 600; }
.opt .tx small { color: var(--mute); font-size: 12.5px; }
.opt.dis { opacity: .45; pointer-events: none; }
.note { font-size: 12.5px; color: var(--mute); padding: 10px 13px; border-radius: 11px; background: rgba(255,255,255,.03); border: 1px solid var(--line); display: flex; gap: 9px; align-items: flex-start; }
.note svg { width: 15px; height: 15px; color: var(--a1); margin-top: 2px; }

/* ------------------------------------------------------------------ MAGAZA */
.shop-top { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
.shop-top .search { flex: 1; min-width: 240px; }
.selp { height: 40px; padding: 0 12px 0 8px; border-radius: 11px; display: flex; align-items: center; gap: 9px; background: var(--panel); border: 1px solid var(--line); cursor: pointer; }
.selp:hover { border-color: var(--line2); }
.selp .picon { width: 28px; height: 28px; border-radius: 8px; }
.selp .picon img { width: 22px; height: 22px; }
.selp .picon svg { width: 15px; height: 15px; }
.selp b { font-weight: 600; font-size: 13px; }
.selp small { color: var(--mute); font-size: 12px; }
select.input { padding: 0 10px; width: auto; cursor: pointer; }
select.input option { background: #16151b; }
.cats { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 16px; }
.cat { height: 30px; padding: 0 12px; border-radius: 99px; font-size: 12.5px; font-weight: 500; color: var(--mute); background: var(--panel); border: 1px solid var(--line); transition: .15s; }
.cat:hover { color: var(--text); }
.cat.on { color: #1c1203; background: var(--agrad); border-color: transparent; font-weight: 600; }
.mods { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 12px; }
.mod { display: flex; gap: 14px; padding: 14px; transition: .15s; align-items: flex-start; }
.mod:hover { border-color: var(--line2); background: rgba(255,255,255,.05); }
.mod .mi { width: 64px; height: 64px; border-radius: 14px; background: var(--panel2); flex: none; object-fit: cover; image-rendering: auto; }
.mod .mt { flex: 1; min-width: 0; }
.mod .mt h3 { font-size: 15.5px; font-weight: 700; display: flex; gap: 8px; align-items: baseline; }
.mod .mt h3 small { font-family: Inter; color: var(--dim); font-size: 12px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mod .mt p { color: var(--mute); font-size: 12.8px; margin-top: 3px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.mod .ms { display: flex; gap: 13px; margin-top: 8px; color: var(--dim); font-size: 12px; align-items: center; }
.mod .ms span { display: flex; gap: 5px; align-items: center; }
.mod .ms svg { width: 13px; height: 13px; }
.mod .ma { display: flex; flex-direction: column; gap: 6px; align-items: flex-end; }
.mod .btn.done { color: #8ff0bd; border-color: rgba(62,224,143,.3); background: rgba(62,224,143,.08); pointer-events: none; }
.more { display: flex; justify-content: center; margin: 20px 0 6px; }
.inst { display: flex; flex-direction: column; gap: 8px; }
.irow { display: flex; align-items: center; gap: 13px; padding: 10px 14px; }
.irow .mi { width: 40px; height: 40px; border-radius: 10px; background: var(--panel2); display: grid; place-items: center; color: var(--dim); flex: none; object-fit: cover; }
.irow .mi svg { width: 18px; }
.irow .tx { flex: 1; min-width: 0; }
.irow .tx b { font-weight: 600; display: flex; gap: 8px; align-items: center; }
.irow .tx small { color: var(--dim); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
.irow.off { opacity: .55; }
.ihead { display: flex; align-items: center; gap: 10px; margin: 6px 0 12px; }
.ihead h3 { font-size: 15px; font-weight: 600; color: var(--mute); flex: 1; }

/* ------------------------------------------------------------------ PVP */
.pvp { display: grid; grid-template-columns: 1fr 440px; gap: 20px; align-items: start; }
.grp { padding: 6px 0; }
.grp h3 { font-size: 13px; text-transform: uppercase; letter-spacing: .12em; color: var(--dim); font-weight: 600; margin: 14px 4px 10px; display: flex; align-items: center; gap: 8px; }
.grp h3 svg { width: 15px; color: var(--a1); }
.setgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.set { display: flex; align-items: center; gap: 12px; padding: 13px 14px; border-radius: 13px; background: var(--panel); border: 1px solid var(--line); transition: .15s; cursor: pointer; }
.set:hover { border-color: var(--line2); }
.set .tx { flex: 1; min-width: 0; }
.set .tx b { display: block; font-weight: 600; font-size: 13.5px; }
.set .tx small { color: var(--mute); font-size: 12px; }
.set.wide { grid-column: 1 / -1; cursor: default; }
.set input[type=color] { width: 34px; height: 34px; border: 0; padding: 0; background: none; border-radius: 9px; cursor: pointer; }
.set input[type=color]::-webkit-color-swatch { border-radius: 9px; border: 2px solid var(--line2); }
.set input[type=color]::-webkit-color-swatch-wrapper { padding: 0; }
.preview { position: sticky; top: 0; padding: 14px; }
.preview h3 { font-size: 13px; color: var(--mute); font-weight: 600; margin: 0 4px 10px; display: flex; justify-content: space-between; }
.scene { aspect-ratio: 16 / 10; border-radius: 13px; overflow: hidden; position: relative; font-family: "Minecraft", Consolas, monospace; image-rendering: pixelated;
  background: linear-gradient(180deg, #7fb3ff 0%, #a9cdfa 46%, #6b9a3a 46.2%, #557e2c 70%, #3f5f20 100%); }
.scene::after { content: ""; position: absolute; inset: 0; background: radial-gradient(transparent 55%, rgba(0,0,0,.45)); }
.scene .sun { position: absolute; width: 30px; height: 30px; background: #fff7c9; right: 22%; top: 14%; box-shadow: 0 0 30px #fff5b0; }
.scene .mob { position: absolute; left: 50%; top: 38%; width: 34px; height: 76px; transform: translateX(-50%); }
.scene .mob i { position: absolute; display: block; }
.scene .tag { position: absolute; left: 50%; top: calc(38% - 22px); transform: translateX(-50%); background: rgba(0,0,0,.35); color: #fff; padding: 1px 4px 2px; font-size: 11px; white-space: nowrap; display: flex; gap: 4px; align-items: center; }
.scene .tag img { width: 11px; height: 11px; image-rendering: pixelated; }
.scene .xh { position: absolute; left: 50%; top: 50%; width: 13px; height: 13px; transform: translate(-50%, -50%); }
.scene .xh::before, .scene .xh::after { content: ""; position: absolute; background: #fff; mix-blend-mode: difference; }
.scene .xh::before { left: 6px; top: 0; width: 1.5px; height: 13px; }
.scene .xh::after { top: 6px; left: 0; height: 1.5px; width: 13px; }
.hud { position: absolute; z-index: 2; font-size: 10.5px; line-height: 1.25; color: var(--hc, #ffc83d); text-shadow: 1px 1px 0 rgba(0,0,0,.6); display: flex; flex-direction: column; gap: 3px; }
.hud .ln { padding: 2px 5px; }
.hud.bg .ln { background: rgba(0,0,0,.42); }
.hud .ln span { color: #fff; }
.keys { position: absolute; left: 8px; bottom: 8px; display: grid; grid-template-columns: repeat(3, 22px); gap: 2px; z-index: 2; }
.keys div { height: 22px; display: grid; place-items: center; background: rgba(0,0,0,.42); color: #fff; font-size: 10px; }
.keys .on { background: rgba(255,255,255,.75); color: #000; }
.keys .wide { grid-column: span 3; height: 10px; }
.keys .half { grid-column: span 1; }
.keys .mb2 { grid-column: span 3; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: none; height: auto; }
.keys .mb2 div { height: 20px; }
.hotbar { position: absolute; left: 50%; bottom: 6px; transform: translateX(-50%); display: flex; gap: 0; z-index: 2; }
.hotbar i { width: 18px; height: 18px; background: rgba(0,0,0,.45); border: 1px solid rgba(255,255,255,.25); }
.hotbar i.s { border: 2px solid #fff; }
.armor { position: absolute; right: 8px; bottom: 8px; z-index: 2; display: flex; flex-direction: column; gap: 2px; font-size: 10px; color: #fff; text-shadow: 1px 1px 0 #000; }
.armor div { display: flex; align-items: center; gap: 4px; }
.armor i { width: 12px; height: 12px; background: #9fd8ff; display: block; }
.fire { position: absolute; left: 0; right: 0; bottom: 0; height: 30%; background: linear-gradient(0deg, rgba(255,120,20,.75), transparent); z-index: 1; transition: height .3s; }
.fire.low { height: 10%; }
.locked { position: relative; }
.lockmsg { position: absolute; inset: 0; z-index: 5; display: grid; place-items: start center; padding-top: 90px !important; text-align: center; padding: 40px; background: rgba(8,8,11,.78); backdrop-filter: blur(4px); border-radius: var(--r); }

/* ------------------------------------------------------------------ AYARLAR */
.sgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
.sc { padding: 20px; display: flex; flex-direction: column; gap: 16px; }
.sc h2 { font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 10px; }
.sc h2 .ic { width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center; background: color-mix(in srgb, var(--a2) 14%, transparent); color: var(--a1); }
.sc h2 .ic svg { width: 17px; }
.ramv { display: flex; align-items: baseline; justify-content: space-between; }
.ramv b { font-family: Outfit; font-size: 28px; font-weight: 700; }
.ramv small { color: var(--mute); }
.ticks { display: flex; justify-content: space-between; color: var(--dim); font-size: 11px; margin-top: 7px; }
.srow { display: flex; align-items: center; gap: 12px; justify-content: space-between; }
.srow .tx b { display: block; font-weight: 600; font-size: 13.5px; }
.srow .tx small { color: var(--mute); font-size: 12px; }
.swatches { display: flex; gap: 9px; }
.swatches button { width: 30px; height: 30px; border-radius: 50%; border: 2px solid transparent; transition: .15s; }
.swatches button.on { border-color: #fff; transform: scale(1.12); }

/* ------------------------------------------------------------------ hesaplar */
.acc { display: flex; align-items: center; gap: 13px; padding: 11px 13px; border-radius: 14px; background: var(--panel); border: 1px solid var(--line); cursor: pointer; transition: .15s; }
.acc:hover { border-color: var(--line2); }
.acc.on { border-color: color-mix(in srgb, var(--a2) 55%, transparent); background: color-mix(in srgb, var(--a2) 8%, transparent); }
.acc img { width: 42px; height: 42px; border-radius: 10px; image-rendering: pixelated; }
.acc .tx { flex: 1; }
.acc .tx b { font-weight: 700; font-size: 15px; display: block; }
.acc .tx small { color: var(--mute); font-size: 12px; }
.code { font-family: Outfit; font-weight: 800; font-size: 40px; letter-spacing: .14em; text-align: center; padding: 18px; border-radius: 16px; background: rgba(0,0,0,.35); border: 1px dashed var(--line2); user-select: text; }

/* ------------------------------------------------------------------ konsol + bildirim */
#console { position: fixed; left: var(--side); right: 0; bottom: 0; height: 46vh; z-index: 120; background: rgba(8,8,10,.97); border-top: 1px solid var(--line2); transform: translateY(102%); transition: transform .32s cubic-bezier(.2, .9, .3, 1); display: flex; flex-direction: column; box-shadow: 0 -30px 60px rgba(0,0,0,.6); }
#console.on { transform: none; }
#console .ch { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--line); }
#console .ch b { flex: 1; font-family: Outfit; font-size: 15px; }
#console pre { flex: 1; overflow: auto; padding: 12px 16px; font: 12px/1.5 Consolas, monospace; color: #b9b4a8; user-select: text; white-space: pre-wrap; word-break: break-all; }
#console pre .w { color: #ffd479; }
#console pre .e { color: #ff8b8b; }
#console pre .h { color: var(--a1); }
#toasts { position: fixed; right: 22px; bottom: 22px; z-index: 400; display: flex; flex-direction: column; gap: 10px; align-items: flex-end; pointer-events: none; }
.toast { pointer-events: auto; max-width: 420px; padding: 12px 16px 12px 13px; border-radius: 14px; background: #1a191f; border: 1px solid var(--line2); box-shadow: 0 20px 50px rgba(0,0,0,.6); display: flex; gap: 11px; align-items: flex-start; font-size: 13.5px; animation: tin .35s cubic-bezier(.2, .9, .3, 1.2); }
.toast.out { animation: tout .25s forwards; }
@keyframes tin { from { opacity: 0; transform: translateX(30px); } }
@keyframes tout { to { opacity: 0; transform: translateX(30px); } }
.toast svg { width: 19px; height: 19px; flex: none; margin-top: 1px; }
.toast.ok svg { color: var(--ok); }
.toast.error svg { color: var(--bad); }
.toast.info svg { color: var(--a1); }
.crashbox { font: 11.5px/1.45 Consolas, monospace; background: rgba(0,0,0,.4); border: 1px solid var(--line); border-radius: 12px; padding: 12px; max-height: 260px; overflow: auto; white-space: pre-wrap; color: #d6b3b3; user-select: text; }

/* boot */
#boot { position: fixed; inset: 0; z-index: 999; background: var(--bg); display: grid; place-items: center; transition: opacity .5s, visibility .5s; }
#boot.done { opacity: 0; visibility: hidden; }
#boot img { width: 92px; height: 92px; animation: bootp 1.4s ease-in-out infinite; filter: drop-shadow(0 10px 40px var(--aglow)); }
@keyframes bootp { 50% { transform: scale(1.07); } }

@media (max-width: 1240px) {
  .hero { grid-template-columns: 1fr 320px; padding-left: 30px; padding-right: 30px; }
  .dock { margin: 0 30px 24px; }
  .dock .meta { display: none; }
  .pvp { grid-template-columns: 1fr 380px; }
  .mods { grid-template-columns: 1fr; }
}

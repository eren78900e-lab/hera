(function bg() {
  const cv = $('#bgfx'), ctx = cv.getContext('2d');
  let W, H, parts = [], last = 0;
  function size() { W = cv.width = innerWidth; H = cv.height = innerHeight; }
  size(); addEventListener('resize', size);
  for (let i = 0; i < 34; i++) parts.push({ x: Math.random(), y: Math.random(), s: 2 + Math.random() * 5, v: .00012 + Math.random() * .00035, a: .04 + Math.random() * .12, r: Math.random() * 6 });
  function frame(t) {
    requestAnimationFrame(frame);
    if (t - last < 33 || document.hidden || document.body.classList.contains('noanim')) return;
    last = t;
    ctx.clearRect(0, 0, W, H);
    const col = getComputedStyle(document.documentElement).getPropertyValue('--a2').trim() || '#ffa020';
    for (const p of parts) {
      p.y -= p.v * 33; if (p.y < -0.05) { p.y = 1.05; p.x = Math.random(); }
      const x = p.x * W + Math.sin(t / 2400 + p.r) * 18, y = p.y * H;
      ctx.globalAlpha = p.a * (page === 'home' ? 1 : .5);
      ctx.fillStyle = col;
      ctx.fillRect(Math.round(x), Math.round(y), p.s, p.s);
    }
  }
  requestAnimationFrame(frame);
})();


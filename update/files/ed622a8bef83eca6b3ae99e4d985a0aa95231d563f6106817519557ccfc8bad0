let cos = { cat: null, tab: 'kafa', worn: {}, view: null, thumbs: {}, profile: null };
function cosProfiles() { return S.profiles.filter(p => p.heraSupported); }
async function openCos() {
  if (!window.CosView) { await new Promise(r => addEventListener('cosview', r, { once: true })); }
  if (!cos.cat) cos.cat = (await (await fetch('cosmetics/catalog.json')).json()).items;
  const ps = cosProfiles();
  cos.profile = ps[0]?.id;
  if (cos.profile) { try { const c = await call('heraGet', { profile: cos.profile }); cos.worn = c.cos || {}; } catch { cos.worn = {}; } }
  if (!cos.view) {
    cos.view = new CosView($('#cosCanvas'), { spin: true });
    cos.skinFor = null;
    $$('.cosbar [data-v]').forEach(b => b.onclick = () => { cos.view.ctl.autoRotate = false; cos.view.view(b.dataset.v); });
  }
  // hesabin kendi skini
  const a = acct();
  if (a && cos.skinFor !== a.name) { cos.skinFor = a.name; call('skin', { name: a.name }).then(u => u && cos.view.setSkin(u)).catch(() => { }); }
  for (const s of ['kafa', 'sirt', 'pelerin']) {
    const it = cos.cat.find(x => x.id === cos.worn[s]);
    await cos.view.set(s, it ? it.id : null, it?.anim);
  }
  drawCos();
  makeThumbs();
}
$$('#cosTabs button').forEach(b => b.onclick = () => { cos.tab = b.dataset.s; $$('#cosTabs button').forEach(x => x.classList.toggle('on', x === b)); drawCos(); });
function drawCos() {
  const items = cos.cat.filter(i => i.slot === cos.tab);
  const worn = cos.worn[cos.tab];
  $('#cosGrid').innerHTML = `<div class="citem ${!worn ? 'on' : ''}" data-id=""><div class="th none">Boş</div><b>Yok</b><small>Bu slotu boş bırak</small></div>` +
    items.map(i => `<div class="citem ${worn === i.id ? 'on' : ''}" data-id="${i.id}">
      ${worn === i.id ? `<span class="badge gold tag">${ic('check')}Giyildi</span>` : ''}
      <div class="th">${cos.thumbs[i.id] ? `<img src="${cos.thumbs[i.id]}">` : '<span class="spin"></span>'}</div>
      <b>${esc(i.name)}</b><small>${esc(i.desc)}</small></div>`).join('');
  const names = Object.values(cos.worn).map(id => cos.cat.find(x => x.id === id)?.name).filter(Boolean);
  $('#cosWorn').textContent = names.length ? names.join(' · ') : 'Hiçbir şey giyilmedi';
  $$('#cosGrid .citem').forEach(c => c.onclick = () => wear(cos.tab, c.dataset.id || null));
}
async function wear(slot, id) {
  if (!cos.profile) { toast('error', 'Önce bir Hera profili gerekli'); return; }
  if (id) cos.worn[slot] = id; else delete cos.worn[slot];
  const it = cos.cat.find(x => x.id === id);
  cos.view.set(slot, id, it?.anim);
  drawCos();
  for (const p of cosProfiles()) await call('heraSet', { profile: p.id, cfg: { cos: cos.worn } }).catch(() => { });
  toast('ok', id ? `${it.name} giyildi — oyunda anında görünür` : 'Çıkarıldı', 2500);
}
let thumbing = false;
async function makeThumbs() {
  if (thumbing) return; thumbing = true;
  const cv = document.createElement('canvas'); cv.width = 320; cv.height = 320;
  cv.style.cssText = 'position:fixed;left:-9999px;width:320px;height:320px'; document.body.appendChild(cv);
  const v = new CosView(cv, { static: true, snap: true });
  for (const it of cos.cat) {
    if (cos.thumbs[it.id]) continue;
    for (const s of ['kafa', 'sirt', 'pelerin']) await v.set(s, null);
    await v.set(it.slot, it.id, null);
    if (it.slot === 'kafa') { v.cam.position.set(-14, 34, -24); v.cam.lookAt(0, 30.5, 0); }
    else if (it.slot === 'sirt') { v.cam.position.set(18, 30, 46); v.cam.lookAt(0, 22, 0); }
    else { v.cam.position.set(14, 22, 38); v.cam.lookAt(0, 18, 2); }
    if (it.slot === 'pelerin') await new Promise(r => setTimeout(r, 250));
    cos.thumbs[it.id] = v.snap();
    if (page === 'cosm' && it.slot === cos.tab) drawCos();
  }
  v.dispose(); cv.parentNode && cv.parentNode.removeChild(cv);
  if (page === 'cosm') drawCos();
}


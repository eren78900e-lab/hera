function addLine(l) {
  const pre = $('#conPre');
  const stick = pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 30;
  const d = document.createElement('div');
  d.textContent = l;
  if (/ERROR|Exception|FATAL/.test(l)) d.className = 'e'; else if (/WARN/.test(l)) d.className = 'w'; else if (l.includes('[Hera]')) d.className = 'h';
  pre.appendChild(d);
  while (pre.childElementCount > 1500) pre.firstElementChild.remove();
  if (stick) pre.scrollTop = pre.scrollHeight;
}
on('log', m => { if ($('#console').classList.contains('on')) addLine(m.line); });

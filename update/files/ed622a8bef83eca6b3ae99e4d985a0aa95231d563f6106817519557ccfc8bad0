      body.insertAdjacentHTML('beforeend', `<div class="more"><button class="btn">Daha fazla göster (${fmtN(r.total - shop.offset - r.hits.length)})</button></div>`);
      $('.more button', body).onclick = () => { shop.offset += 24; shopSearch(false); };
    }
    bindMods();
  } catch (e) { if (shop.token === token) body.innerHTML = `<div class="empty">${ic('warn')}<div>${esc(e.message)}</div></div>`; }
}
function modCard(h) {

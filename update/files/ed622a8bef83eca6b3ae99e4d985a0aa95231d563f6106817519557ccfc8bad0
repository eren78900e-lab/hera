    const it = e.target.closest('.it'); if (!it) return;
    closePop();
    if (it.dataset.new) profileModal(); else pick(it.dataset.id);
  };
  setTimeout(() => document.addEventListener('mousedown', popAway), 0);
}
function popAway(e) { if (!e.target.closest('.pop')) closePop(); }
function closePop() { $$('.pop').forEach(p => p.remove()); document.removeEventListener('mousedown', popAway); }

/* oyna dugmesi */
let prog = { stage: 'Hazır', done: 0, total: 0, bytes: 0 }, lastBytes = 0, lastT = 0, speed = 0;
function setPlay() {
  const b = $('#playBtn');
  b.classList.toggle('busy', gameState === 'preparing');
  b.classList.toggle('running', gameState === 'running');
  if (gameState === 'preparing') b.innerHTML = `<span class="spin"></span><span>İPTAL</span>`;
  else if (gameState === 'running') b.innerHTML = `${ic('check')}<span>OYUNDA<small>Konsolu aç</small></span>`;
  else b.innerHTML = `${ic('play')}<span>OYNA</span>`;
  const bar = $('#progBar');
  if (gameState === 'idle') {
    $('#progStage').textContent = acct() ? 'Hazır — oyna.crafthera.com' : 'Önce bir hesap ekle';
    $('#progPct').textContent = '';
    bar.classList.remove('ind'); bar.firstElementChild.style.width = '0';
  } else if (gameState === 'running') {
    $('#progStage').textContent = 'Oyun çalışıyor';
    $('#progPct').textContent = '';
    bar.classList.remove('ind'); bar.firstElementChild.style.width = '100%';
  }
}
on('game', m => {
  gameState = m.state;
  if (S) S.game = m.state;
  if (m.state === 'preparing') { prog = { stage: 'Hazırlanıyor' }; lastBytes = 0; }
  setPlay();
  if (m.state === 'running') { $('#conPre').innerHTML = ''; if (S.settings.consoleOnLaunch) $('#console').classList.add('on'); }
});
on('progress', m => {
  if (gameState !== 'preparing') return;
  const now = performance.now();
  if (m.stage !== prog.stage) { lastBytes = 0; lastT = now; speed = 0; }
  if (m.bytes && now - lastT > 400) { speed = (m.bytes - lastBytes) / ((now - lastT) / 1000); lastBytes = m.bytes; lastT = now; }
  prog = m;
  $('#progStage').textContent = m.stage + (m.detail ? ' · ' + m.detail : '');
  const bar = $('#progBar');
  if (m.total > 0) {
    bar.classList.remove('ind');
    const pc = Math.min(100, m.done / m.total * 100);
    bar.firstElementChild.style.width = pc + '%';
    $('#progPct').textContent = `${m.done}/${m.total}` + (m.bytes ? ` · ${fmtMB(m.bytes)}` + (speed > 0 ? ` · ${fmtMB(speed)}/sn` : '') : '');
  } else { bar.classList.add('ind'); $('#progPct').textContent = ''; }
});
$('#playBtn').onclick = async () => {
  if (gameState === 'preparing') { post({ cmd: 'cancel' }); return; }
  if (gameState === 'running') { openConsole(); return; }
  if (!acct()) { accountsModal(); return; }
  try { await call('play', { profile: S.settings.selectedProfile }); }
  catch (e) { toast('error', e.message, 7000); }
};

/* sunucu */
function motdHtml(d) {
  const COL = { black: '#000', dark_blue: '#0000AA', dark_green: '#00AA00', dark_aqua: '#00AAAA', dark_red: '#AA0000', dark_purple: '#AA00AA', gold: '#FFAA00', gray: '#AAAAAA', dark_gray: '#555555', blue: '#5555FF', green: '#55FF55', aqua: '#55FFFF', red: '#FF5555', light_purple: '#FF55FF', yellow: '#FFFF55', white: '#FFFFFF' };
  const CODE = '0123456789abcdef'; const CN = Object.keys(COL);
  let out = '';
  function legacy(s, base) {
    let col = base || '#AAAAAA', b = false;
    const parts = String(s).split('§');
    out += `<span style="color:${col}">${esc(parts[0])}</span>`;
    for (let i = 1; i < parts.length; i++) {
      const c = parts[i][0], t = parts[i].slice(1);
      const k = CODE.indexOf((c || '').toLowerCase());
      if (k >= 0) { col = COL[CN[k]]; b = false; }
      else if (c === 'l') b = true; else if (c === 'r') { col = '#AAAAAA'; b = false; }
      out += `<span style="color:${col};${b ? 'font-weight:700' : ''}">${esc(t)}</span>`;
    }
  }
  function walk(n, inh) {
    if (typeof n === 'string') { legacy(n, inh.color); return; }
    if (!n) return;
    const st = { color: n.color ? (COL[n.color] || n.color) : inh.color, bold: n.bold ?? inh.bold };
    if (n.text) { if (n.text.includes('§')) legacy(n.text, st.color); else out += `<span style="color:${st.color || '#AAAAAA'};${st.bold ? 'font-weight:700' : ''}">${esc(n.text)}</span>`; }
    (n.extra || []).forEach(x => walk(x, st));
  }
  walk(d, {});
  return out;
}
async function pingServer() {
  const btn = $('#srvRefresh'); btn.classList.add('ld');
  try {
    const r = await call('server');
    $('#srvOnline').textContent = `${(r.players?.online ?? 0).toLocaleString('tr-TR')}`;
    $('#srvDot').classList.remove('off');
    $('#srvPing').textContent = r.ping >= 0 ? r.ping + ' ms' : '—';
    $('#srvMotd').innerHTML = motdHtml(r.description) || 'CraftHera';
    if (r.favicon) $('#srvIco').src = r.favicon;
  } catch (e) {
    $('#srvOnline').textContent = 'Kapalı';
    $('#srvDot').classList.add('off');
    $('#srvPing').textContent = '—';
    $('#srvMotd').textContent = 'Sunucuya ulaşılamadı.';
  }
  btn.classList.remove('ld');
}

/* ================================================================ modal yardimcilari */
function modal(html, cls = '') {
  const bg = document.createElement('div');
  bg.className = 'modal-bg';
  bg.innerHTML = `<div class="modal ${cls}">${html}</div>`;
  document.body.appendChild(bg);
  bg.addEventListener('mousedown', e => { if (e.target === bg) closeModal(bg); });
  $$('[data-x]', bg).forEach(b => b.onclick = () => closeModal(bg));
  return bg;
}
function closeModal(m) { if (m && m.onclose) m.onclose(); m?.remove(); }
function confirmModal(title, body, okText, fn) {
  const m = modal(`<div class="mh"><h2>${title}</h2></div><div class="mb"><div>${body}</div></div>
    <div class="mf"><button class="btn ghost" data-x>Vazgeç</button><button class="btn pri" id="cfOk">${okText}</button></div>`, 'sm');
  $('#cfOk', m).onclick = async () => { try { await fn(); closeModal(m); } catch (e) { toast('error', e.message); } };
}
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { const ms = $$('.modal-bg'); if (ms.length) closeModal(ms[ms.length - 1]); else if ($('#console').classList.contains('on')) $('#console').classList.remove('on'); closePop(); }
});


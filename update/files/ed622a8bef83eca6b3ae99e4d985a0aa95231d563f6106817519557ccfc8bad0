async function shopSearch(reset) {
  const body = $('#shopBody');
  body.dataset.loaded = '1'; body.dataset.p = shop.profile;
  if (shop.type === 'installed') return drawInstalled();
  const p = shopProfile();
  if (reset) {
    shop.offset = 0;
    body.innerHTML = `<div class="mods">${Array.from({ length: 6 }, () => `<div class="card mod"><div class="mi skel"></div><div class="mt"><div class="skel" style="height:16px;width:45%"></div><div class="skel" style="height:12px;width:90%;margin-top:9px"></div><div class="skel" style="height:12px;width:70%;margin-top:6px"></div></div></div>`).join('')}</div>`;
  }
  if (p.loader === 'vanilla' && shop.type !== 'resourcepack') {
    body.innerHTML = `<div class="empty">${ic('box')}<div><b>${esc(p.name)}</b> bir Vanilla profili.</div><div style="margin-top:4px">Mod ve shader için Fabric profili seç ya da oluştur.</div><button class="btn pri" style="margin-top:16px" onclick="profileModal()">${ic('plus')}Fabric profili oluştur</button></div>`;
    return;
  }
  const token = Symbol(); shop.token = token;
  try {
    const r = await call('mrSearch', { profile: p.id, type: shop.type, q: shop.q, sort: shop.sort, offset: shop.offset, category: shop.cat });
    if (shop.token !== token) return;
    shop.installed = new Set(r.installed); shop.total = r.total;
    const cards = r.hits.map(h => modCard(h)).join('');
    if (reset) body.innerHTML = r.hits.length ? `<div class="mods">${cards}</div>` : `<div class="empty">${ic('search')}<div>Bu sürüm için sonuç yok</div></div>`;
    else $('.mods', body).insertAdjacentHTML('beforeend', cards);

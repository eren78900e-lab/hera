'use strict';
/* ================================================================ kopru */
const host = window.chrome && window.chrome.webview;
let ridSeq = 0;
const pending = new Map();
const listeners = {};
function call(cmd, data = {}) {
  return new Promise((res, rej) => {
    const rid = ++ridSeq;
    pending.set(rid, { res, rej });
    post({ cmd, rid, ...data });
  });
}
function post(o) { if (host) host.postMessage(o); else mockHost(o); }
function on(ev, fn) { (listeners[ev] = listeners[ev] || []).push(fn); }
function onMsg(m) {
  if (m.ev === 'reply') {
    const p = pending.get(m.rid); if (!p) return;
    pending.delete(m.rid);
    m.ok ? p.res(m.data) : p.rej(new Error(m.error || 'Hata'));
    return;
  }
  (listeners[m.ev] || []).forEach(f => f(m));
}
if (host) host.addEventListener('message', e => onMsg(e.data));

/* ================================================================ yardimcilar */
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const ic = (n, cls = '') => `<svg class="i ${cls}"><use href="#i-${n}"/></svg>`;
const fmtN = n => n >= 1e6 ? (n / 1e6).toFixed(n >= 1e7 ? 0 : 1).replace('.', ',') + ' Mn' : n >= 1e3 ? (n / 1e3).toFixed(n >= 1e4 ? 0 : 1).replace('.', ',') + ' B' : String(n);
const fmtMB = b => (b / 1048576).toFixed(b > 1e8 ? 0 : 1).replace('.', ',') + ' MB';
function ago(ms) {
  if (!ms) return 'Hiç';
  const s = (Date.now() - ms) / 1000;
  if (s < 60) return 'Az önce';
  if (s < 3600) return Math.floor(s / 60) + ' dk önce';
  if (s < 86400) return Math.floor(s / 3600) + ' saat önce';
  if (s < 86400 * 30) return Math.floor(s / 86400) + ' gün önce';
  return new Date(ms).toLocaleDateString('tr-TR');
}
function dur(ms) {
  const m = Math.floor((ms || 0) / 60000);
  if (m < 60) return m + ' dk';
  return Math.floor(m / 60) + ' sa ' + (m % 60) + ' dk';
}
function toast(kind, text, ms = 4200) {
  const t = document.createElement('div');
  t.className = 'toast ' + kind;
  t.innerHTML = ic(kind === 'ok' ? 'check' : kind === 'error' ? 'warn' : 'info') + `<div>${esc(text)}</div>`;
  $('#toasts').appendChild(t);
  setTimeout(() => { t.classList.add('out'); setTimeout(() => t.remove(), 300); }, ms);
}
function head(name, size = 64) { return `https://mc-heads.net/avatar/${encodeURIComponent(name || 'MHF_Steve')}/${size}`; }
const STEVE = 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 8" shape-rendering="crispEdges"><rect width="8" height="8" fill="#6b4a2f"/><rect y="2" width="8" height="6" fill="#b58a6a"/><rect x="1" y="4" width="2" height="1" fill="#fff"/><rect x="2" y="4" width="1" height="1" fill="#4a3a8a"/><rect x="5" y="4" width="2" height="1" fill="#fff"/><rect x="5" y="4" width="1" height="1" fill="#4a3a8a"/><rect x="3" y="6" width="2" height="1" fill="#6b4a2f"/></svg>');

const ICONS = ['crown', 'sword', 'shield', 'pick', 'grass', 'gem', 'fire', 'star', 'rocket', 'bolt'];
function picon(p, cls = 'picon') {
  const i = p && p.icon || 'crown';
  return `<div class="${cls}">${i === 'crown' ? '<img src="logo.png" alt="">' : ic(i)}</div>`;
}
